{
  "name": "n8n-nodes-veycall",
  "version": "0.1.0",
  "description": "VeyCall for n8n: your AI agent answers on Gmail, Messenger, Slack, Mattermost, WhatsApp Business and any other platform (text and voice notes), and your leads, conversations and knowledge are one node away.",
  "keywords": [
    "n8n-community-node-package",
    "veycall",
    "ai agent",
    "ai receptionist",
    "voice agent",
    "leads"
  ],
  "license": "MIT",
  "homepage": "https://veycall.com/integrations/n8n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veycallai/n8n-nodes-veycall.git"
  },
  "bugs": {
    "url": "https://github.com/veycallai/n8n-nodes-veycall/issues"
  },
  "author": {
    "name": "VeyCall",
    "email": "support@veycall.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/VeyCallApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/VeyCall/VeyCall.node.js",
      "dist/nodes/VeyCall/VeyCallTrigger.node.js",
      "dist/nodes/VeyCall/VeyCallActionTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
